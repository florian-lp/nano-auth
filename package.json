{
	"name": "nano-auth",
	"version": "0.3.0",
	"type": "module",
	"description": "",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/types/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"typesVersions": {
		"*": {
			"client": ["./dist/types/client.d.ts"]
		}
	},
	"repository": "infinityfx-llc/nano-auth",
	"author": "InfinityFX <contact@infinity-fx.com> (https://infinityfx.dev)",
	"license": "GPL-3.0",
	"bugs": "https://github.com/infinityfx-llc/nano-auth/issues",
	"homepage": "https://github.com/infinityfx-llc/nano-auth",
	"funding": "https://ko-fi.com/infinityfx",
	"keywords": [
		"auth",
		"oauth",
		"jwt",
		"react",
		"nextjs",
		"typescript"
	],
	"scripts": {
		"build": "rollup -c --environment NODE_ENV:production",
		"watch": "rollup -c -w"
	},
	"dependencies": {
		"tslib": "^2.8.1",
		"jose": "^6.2.12"
	},
	"peerDependencies": {
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0",
		"next": ">=15.1.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"next": "^16.3.8",
		"rollup": "^4.63.6",
		"rollup-plugin-delete": "^3.0.2",
		"typescript": "^6.0.3"
	},
	"sideEffects": false
}